import { Button, CheckBox, HorizontalBox, LineEdit, ScrollView, Slider, SpinBox, VerticalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    width: 900px;
    height: 800px;
    title: "Focus on Work";
    background: #10131a;

    in-out property <string> status-text: "Ready";
    in-out property <string> timer-text: "--:--:--";
    in-out property <string> active-profile: "Study";
    in-out property <int> duration-minutes: 60;
    in-out property <bool> allow-list-mode: false;
    in-out property <bool> lock-enabled: false;
    in-out property <bool> session-active: false;
    in-out property <bool> social-media-enabled: true;
    in-out property <bool> games-enabled: false;
    in-out property <bool> videos-enabled: false;
    in-out property <string> custom-sites: "";
    in-out property <string> custom-apps: "";

    callback start-session();
    callback refresh-status();
    callback export-config();
    callback import-config();
    callback toggle-lock();

    ScrollView {
        width: parent.width;
        height: parent.height;
        VerticalBox {
            width: parent.width;
            padding: 28px;
            spacing: 18px;

        Text {
            text: "Focus on Work";
            color: #f5f7fb;
            font-size: 30px;
            font-weight: 700;
        }
        Text {
            text: "Choose a profile, block distractions, and protect your focus.";
            color: #9da7b8;
            font-size: 15px;
        }

        HorizontalBox {
            spacing: 10px;
            Button { text: "Study"; clicked => { active-profile = "Study"; } }
            Button { text: "Work"; clicked => { active-profile = "Work"; } }
            Button { text: "Sleep"; clicked => { active-profile = "Sleep"; } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Refresh"; clicked => { refresh-status(); } }
        }

        Rectangle {
            background: #191e29;
            border-radius: 14px;
            VerticalBox {
                padding: 20px;
                spacing: 10px;
                Text { text: "Session"; color: #aab4c5; font-size: 14px; }
                Text {
                    text: timer-text;
                    color: #7dd3fc;
                    font-size: 54px;
                    horizontal-alignment: center;
                }
                Text {
                    text: status-text;
                    color: #d7deea;
                    horizontal-alignment: center;
                }
            }
        }

        HorizontalBox {
            spacing: 18px;
            VerticalBox {
                spacing: 10px;
                Text { text: "Block categories"; color: #f5f7fb; font-size: 18px; }
                CheckBox { text: "Social media"; checked <=> social-media-enabled; enabled: !lock-enabled; }
                CheckBox { text: "Games"; checked <=> games-enabled; enabled: !lock-enabled; }
                CheckBox { text: "Video sites"; checked <=> videos-enabled; enabled: !lock-enabled; }
                CheckBox {
                    text: "Custom list only";
                    checked <=> allow-list-mode;
                    enabled: !lock-enabled;
                }
            }
            VerticalBox {
                spacing: 10px;
                Text { text: "Duration (minutes)"; color: #f5f7fb; font-size: 18px; }
                Slider {
                    minimum: 15;
                    maximum: 480;
                    value: duration-minutes;
                    enabled: !lock-enabled;
                    changed => { duration-minutes = self.value; }
                }
                SpinBox {
                    minimum: 15;
                    maximum: 480;
                    value <=> duration-minutes;
                    enabled: !lock-enabled;
                }
                Text {
                    text: "Profile: " + active-profile;
                    color: #9da7b8;
                }
            }
        }

        Rectangle {
            background: #191e29;
            border-radius: 12px;
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text { text: "Your websites and apps"; color: #f5f7fb; font-size: 18px; }
                Text {
                    text: "Websites: comma-separated domains, e.g. reddit.com, news.ycombinator.com";
                    color: #9da7b8;
                    font-size: 12px;
                }
                LineEdit {
                    placeholder-text: "reddit.com, example.com";
                    text <=> custom-sites;
                    enabled: !lock-enabled;
                }
                Text {
                    text: "Apps: process names or keywords, e.g. firefox, steam, discord";
                    color: #9da7b8;
                    font-size: 12px;
                }
                LineEdit {
                    placeholder-text: "steam, discord";
                    text <=> custom-apps;
                    enabled: !lock-enabled;
                }
            }
        }

        HorizontalBox {
            spacing: 10px;
            Button {
                text: session-active ? "Session active" : "Start focus session";
                enabled: !session-active && !lock-enabled;
                clicked => { start-session(); }
            }
            Button {
                text: lock-enabled ? "Unlock settings" : "Lock settings";
                clicked => { toggle-lock(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Import JSON"; enabled: !lock-enabled; clicked => { import-config(); } }
            Button { text: "Export JSON"; enabled: !lock-enabled; clicked => { export-config(); } }
        }
            Text {
                text: lock-enabled ? "Settings locked. Unlock to change the next session." : "Settings are unlocked.";
                color: lock-enabled ? #fbbf24 : #7f8da3;
                wrap: word-wrap;
            }
        }
    }
}
