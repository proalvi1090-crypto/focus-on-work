[Unit]
Description=focus-on-work website and process blocker
After=local-fs.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/focus-on-work-daemon
Restart=always
RestartSec=2s
ProtectSystem=full
ReadWritePaths=/etc /run
StateDirectory=focus-on-work
RuntimeDirectory=focus-on-work
RuntimeDirectoryMode=0770
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_KILL CAP_DAC_OVERRIDE CAP_FOWNER

[Install]
WantedBy=multi-user.target
